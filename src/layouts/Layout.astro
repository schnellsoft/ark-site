---
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import Header from '../components/header/Header.astro';

interface Props {
	title?: string;
}
const { title = 'Ark' } = Astro.props;
---

<!doctype html>
<html lang="ro">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#121516" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} Ark Medical Clinic</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--header-block-size: 3.75rem;
		--primary: #ffe082;
		--primary-hover: #ff9a3c;
		--bg: #0f1112;
		--bg-elevated: #1a1a1a;
		--fg: #ffe082;
		--border: #2a2a2a;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-padding-top: var(--header-block-size);
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: 'Roboto', system-ui, sans-serif;
		line-height: 1.6;
		min-height: 100dvh;
	}

	a {
		color: inherit;
	}

	:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	main {
		padding-top: var(--header-block-size);
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
	}

	.site-footer {
		padding: 1.5rem;
		text-align: center;
		background: var(--bg-elevated);
		border-top: 1px solid var(--border);
	}

	.site-footer p {
		margin: 0;
	}
</style>
