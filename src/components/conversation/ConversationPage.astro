---
import './conversation-page.css';

const copy = {
	title: {
		ro: 'Conversație',
		en: 'Conversation',
		bg: 'Разговор',
	},
	empty: {
		ro: 'Nu ai o conversație activă. Completează formularul de contact pentru a deschide un tichet.',
		en: 'You have no active conversation. Fill in the contact form to open a ticket.',
		bg: 'Нямате активен разговор. Попълнете контактната форма, за да отворите тикет.',
	},
	cta: {
		ro: 'Mergi la contact',
		en: 'Go to contact',
		bg: 'Към контакти',
	},
	you: { ro: 'Tu', en: 'You', bg: 'Вие' },
	clinic: { ro: 'Recepție', en: 'Reception', bg: 'Рецепция' },
	expires: {
		ro: 'Conversatia se păstrează local 7 zile.',
		en: 'This conversation is kept locally for 7 days.',
		bg: 'Разговорът се пази локално 7 дни.',
	},
	placeholder: {
		ro: 'Scrie un mesaj…',
		en: 'Write a message…',
		bg: 'Напишете съобщение…',
	},
	send: { ro: 'Trimite', en: 'Send', bg: 'Изпрати' },
};
---

<section class="convo-page" data-convo-page data-convo-copy={JSON.stringify(copy)} aria-label={copy.title.ro}>
	<h1 class="convo-page__title" data-convo-title>{copy.title.ro}</h1>
	<p class="convo-page__meta" data-convo-meta>{copy.expires.ro}</p>

	<div class="convo-empty" data-convo-empty hidden>
		<p data-convo-empty-text>{copy.empty.ro}</p>
		<a href="/contact/" data-convo-cta>{copy.cta.ro}</a>
	</div>

	<div class="convo-thread" data-convo-thread hidden aria-live="polite"></div>

	<form class="convo-composer" data-convo-composer hidden>
		<label class="visually-hidden" for="convo-input">Message</label>
		<textarea id="convo-input" data-convo-input maxlength="4000" rows="2"></textarea>
		<button type="submit" data-convo-send>{copy.send.ro}</button>
	</form>
</section>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	import { getLang, LANG_CHANGE_EVENT, type Lang } from '../../scripts/header/lang';
	import {
		appendMessage,
		getActiveConversation,
		newMessage,
		type TicketConversation,
	} from '../../scripts/tickets-db';

	type Copy = Record<string, Record<Lang, string>>;

	function boot() {
		const root = document.querySelector<HTMLElement>('[data-convo-page]');
		if (!root || root.dataset.booted) return;
		root.dataset.booted = '1';

		const raw = root.dataset.convoCopy;
		if (!raw) return;
		let copy: Copy;
		try {
			copy = JSON.parse(raw) as Copy;
		} catch {
			return;
		}

		const titleEl = root.querySelector('[data-convo-title]');
		const metaEl = root.querySelector('[data-convo-meta]');
		const emptyEl = root.querySelector<HTMLElement>('[data-convo-empty]');
		const emptyText = root.querySelector('[data-convo-empty-text]');
		const ctaEl = root.querySelector('[data-convo-cta]');
		const threadEl = root.querySelector<HTMLElement>('[data-convo-thread]');
		const composer = root.querySelector<HTMLFormElement>('[data-convo-composer]');
		const input = root.querySelector<HTMLTextAreaElement>('[data-convo-input]');
		const sendBtn = root.querySelector('[data-convo-send]');

		let convo: TicketConversation | null = null;

		function paintLabels(lang: Lang) {
			if (titleEl) titleEl.textContent = copy.title[lang] || copy.title.ro;
			if (metaEl) metaEl.textContent = copy.expires[lang] || copy.expires.ro;
			if (emptyText) emptyText.textContent = copy.empty[lang] || copy.empty.ro;
			if (ctaEl) ctaEl.textContent = copy.cta[lang] || copy.cta.ro;
			if (input) input.placeholder = copy.placeholder[lang] || copy.placeholder.ro;
			if (sendBtn) sendBtn.textContent = copy.send[lang] || copy.send.ro;
		}

		function renderThread(lang: Lang) {
			if (!threadEl) return;
			threadEl.innerHTML = '';
			if (!convo) return;
			for (const msg of convo.messages) {
				const el = document.createElement('article');
				el.className = `convo-msg convo-msg--${msg.role === 'patient' ? 'patient' : 'clinic'}`;
				const who = document.createElement('span');
				who.className = 'convo-msg__who';
				who.textContent =
					msg.role === 'patient'
						? copy.you[lang] || copy.you.ro
						: copy.clinic[lang] || copy.clinic.ro;
				const body = document.createElement('div');
				body.textContent = msg.body;
				el.append(who, body);
				threadEl.appendChild(el);
			}
			requestAnimationFrame(() => {
				threadEl.scrollTop = threadEl.scrollHeight;
			});
		}

		async function load() {
			const lang = getLang();
			paintLabels(lang);
			convo = await getActiveConversation();
			if (!convo) {
				emptyEl && (emptyEl.hidden = false);
				threadEl && (threadEl.hidden = true);
				composer && (composer.hidden = true);
				return;
			}
			emptyEl && (emptyEl.hidden = true);
			threadEl && (threadEl.hidden = false);
			composer && (composer.hidden = false);
			if (metaEl) {
				const until = new Date(convo.expiresAt).toLocaleString(
					lang === 'bg' ? 'bg-BG' : lang === 'en' ? 'en-GB' : 'ro-RO',
				);
				metaEl.textContent = `${copy.expires[lang] || copy.expires.ro} · ${convo.patientName} · until ${until}`;
			}
			renderThread(lang);
		}

		composer?.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!convo || !input) return;
			const text = input.value.trim();
			if (!text) return;
			input.value = '';
			const updated = await appendMessage(convo.id, newMessage('patient', text));
			if (updated) {
				convo = updated;
				renderThread(getLang());
			}
		});

		window.addEventListener(LANG_CHANGE_EVENT, () => {
			const lang = getLang();
			paintLabels(lang);
			if (convo) renderThread(lang);
		});

		void load();
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
