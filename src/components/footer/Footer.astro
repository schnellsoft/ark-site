---
import contactData from '../../data/contact/contact.json';
import footerData from '../../data/footer/footer.json';
import locationData from '../../data/location/location.json';
import scheduleData from '../../data/schedule/schedule.json';
import { resolveLangLabel } from '../../lib/header';
import { spriteSymbolId } from '../../lib/icons';

type ScheduleDay = { day: number; open_time: string; close_time: string };
type FooterIcon = {
	name?: string;
	label?: { ro?: string; bg?: string; en?: string } | string;
	'aria-label'?: string;
	link?: string;
};

const year = new Date().getFullYear();
const days = (scheduleData.days ?? []) as ScheduleDay[];
const icons = ((footerData as { icons?: FooterIcon[] }).icons ?? []).filter((icon) =>
	spriteSymbolId(icon.name),
);

const address = String((locationData as { address?: string }).address ?? '').trim();
const phone = String((contactData as { phone?: string }).phone ?? '').trim();
const email = String((contactData as { email?: string }).email ?? '').trim();
const phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : '';
const hasContact = Boolean(address || phone || email);

const WEEKDAY_LABELS: Record<number, { ro: string; bg: string; en: string }> = {
	1: { ro: 'Luni', bg: 'Понеделник', en: 'Monday' },
	2: { ro: 'Marți', bg: 'Вторник', en: 'Tuesday' },
	3: { ro: 'Miercuri', bg: 'Сряда', en: 'Wednesday' },
	4: { ro: 'Joi', bg: 'Четвъртък', en: 'Thursday' },
	5: { ro: 'Vineri', bg: 'Петък', en: 'Friday' },
	6: { ro: 'Sâmbătă', bg: 'Събота', en: 'Saturday' },
	7: { ro: 'Duminică', bg: 'Неделя', en: 'Sunday' },
};

function formatHours(open: string, close: string): string {
	const o = (open ?? '').trim();
	const c = (close ?? '').trim();
	if (!o && !c) return '';
	if (o && c) return `${o} – ${c}`;
	return o || c;
}
---

<footer class="site-footer" id="contact">
	<div class="site-footer__inner">
		<div class="site-footer__grid">
			{
				hasContact && (
					<div class="site-footer__contact">
						<h2
							class="site-footer__heading"
							data-i18n-ro="Contact"
							data-i18n-bg="Контакт"
							data-i18n-en="Contact"
						>
							Contact
						</h2>
						<ul class="site-footer__contact-list">
							{address ? (
								<li class="site-footer__contact-item">
									<span
										class="site-footer__contact-label"
										data-i18n-ro="Adresă"
										data-i18n-bg="Адрес"
										data-i18n-en="Address"
									>
										Adresă
									</span>
									<span class="site-footer__contact-value">{address}</span>
								</li>
							) : null}
							{phone ? (
								<li class="site-footer__contact-item">
									<span
										class="site-footer__contact-label"
										data-i18n-ro="Telefon"
										data-i18n-bg="Телефон"
										data-i18n-en="Phone"
									>
										Telefon
									</span>
									<a class="site-footer__contact-value" href={phoneHref}>
										{phone}
									</a>
								</li>
							) : null}
							{email ? (
								<li class="site-footer__contact-item">
									<span
										class="site-footer__contact-label"
										data-i18n-ro="Email"
										data-i18n-bg="Имейл"
										data-i18n-en="Email"
									>
										Email
									</span>
									<a class="site-footer__contact-value" href={`mailto:${email}`}>
										{email}
									</a>
								</li>
							) : null}
						</ul>
					</div>
				)
			}

			<div class="site-footer__schedule">
				<h2
					class="site-footer__heading"
					data-i18n-ro="Program"
					data-i18n-bg="График"
					data-i18n-en="Hours"
				>
					Program
				</h2>
				<ul class="site-footer__days">
					{
						([1, 2, 3, 4, 5, 6, 7] as const).map((dayNum) => {
							const row = days.find((d) => d.day === dayNum);
							const labels = WEEKDAY_LABELS[dayNum];
							const hours = formatHours(row?.open_time ?? '', row?.close_time ?? '');
							return (
								<li class="site-footer__day">
									<span
										class="site-footer__day-name"
										data-i18n-ro={labels.ro}
										data-i18n-bg={labels.bg}
										data-i18n-en={labels.en}
									>
										{labels.ro}
									</span>
									{hours ? (
										<span class="site-footer__day-hours">{hours}</span>
									) : (
										<span
											class="site-footer__day-hours site-footer__day-hours--closed"
											data-i18n-ro="Închis"
											data-i18n-bg="Затворено"
											data-i18n-en="Closed"
										>
											Închis
										</span>
									)}
								</li>
							);
						})
					}
				</ul>
			</div>

			{
				icons.length > 0 && (
					<nav class="site-footer__icons" aria-label="Social">
					{icons.map((icon) => {
						const id = spriteSymbolId(icon.name);
						const fallback =
							icon['aria-label'] ||
							resolveLangLabel(icon.label, 'ro') ||
							id;
						const labelRo =
							resolveLangLabel(icon.label, 'ro') || fallback;
						const labelBg =
							resolveLangLabel(icon.label, 'bg') || fallback;
						const labelEn =
							resolveLangLabel(icon.label, 'en') || fallback;
						return (
							<a
								class="site-footer__icon-link"
								href={icon.link || '#'}
								aria-label={fallback}
								data-i18n-ro={labelRo}
								data-i18n-bg={labelBg}
								data-i18n-en={labelEn}
								data-i18n-aria-only
								rel={icon.link?.startsWith('http') ? 'noopener noreferrer' : undefined}
								target={icon.link?.startsWith('http') ? '_blank' : undefined}
							>
									<svg
										viewBox="0 0 24 24"
										aria-hidden="true"
										focusable="false"
										class="site-footer__icon"
									>
										<use href={`#${id}`} />
									</svg>
								</a>
							);
						})}
					</nav>
				)
			}
		</div>

		<p class="site-footer__copy">&copy; {year} Ark Medical Clinic</p>
	</div>
</footer>

<style>
	.site-footer {
		--footer-icon-size: 1.25rem;
		--footer-icon-target: 2.75rem;
		--sprite-cutout: var(--bg-elevated, #1a1a1a);
		container-type: inline-size;
		container-name: site-footer;
		margin-block-start: auto;
		padding-block: clamp(1.75rem, 4vw, 3rem);
		padding-inline: 0;
		background: var(--bg-elevated);
		border-block-start: 2px solid color-mix(in srgb, var(--accent) 55%, var(--border));
	}

	.site-footer__inner {
		/* Match header / services content column */
		box-sizing: border-box;
		inline-size: 100%;
		max-inline-size: var(--content-max, 90rem);
		margin-inline: auto;
		padding-inline: var(--content-inline, clamp(0.75rem, 2vw, 1.5rem));
		display: grid;
		gap: 1.75rem;
	}

	.site-footer__grid {
		display: grid;
		gap: 1.75rem 2rem;
		align-items: start;
		justify-items: stretch;
	}

	.site-footer__heading {
		margin: 0 0 0.85rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--fg) 68%, transparent);
	}

	.site-footer__contact-list,
	.site-footer__days {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-footer__contact-list {
		display: grid;
		gap: 0.75rem;
	}

	.site-footer__contact-item {
		display: grid;
		gap: 0.2rem;
		min-inline-size: 0;
	}

	.site-footer__contact-label {
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--fg) 52%, transparent);
	}

	.site-footer__contact-value {
		color: var(--fg);
		text-decoration: none;
		font-size: 0.95rem;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	a.site-footer__contact-value:hover {
		color: var(--primary, #ffe082);
	}

	.site-footer__days {
		display: grid;
		gap: 0.4rem;
	}

	.site-footer__day {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		font-size: 0.9rem;
		min-inline-size: 0;
	}

	.site-footer__day-name {
		color: color-mix(in srgb, var(--fg) 85%, transparent);
		min-inline-size: 0;
	}

	.site-footer__day-hours {
		font-variant-numeric: tabular-nums;
		color: var(--accent, #ffe082);
		white-space: nowrap;
	}

	.site-footer__day-hours--closed {
		color: color-mix(in srgb, var(--fg) 45%, transparent);
	}

	.site-footer__icons {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.site-footer__icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: var(--footer-icon-target);
		block-size: var(--footer-icon-target);
		border-radius: 0.5rem;
		color: var(--fg);
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		border: 1px solid var(--border);
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background-color 160ms ease,
			transform 100ms ease;
		-webkit-tap-highlight-color: transparent;
	}

	.site-footer__icon {
		inline-size: var(--footer-icon-size);
		block-size: var(--footer-icon-size);
		display: block;
		flex-shrink: 0;
		fill: currentColor;
		color: inherit;
	}

	.site-footer__icon use {
		fill: currentColor;
		color: inherit;
	}

	.site-footer__copy {
		margin: 0;
		padding-block-start: 0.25rem;
		font-size: 0.85rem;
		color: color-mix(in srgb, var(--fg) 55%, transparent);
		text-align: center;
	}

	@container site-footer (min-width: 36rem) {
		.site-footer__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.site-footer__icons {
			grid-column: 1 / -1;
			justify-content: flex-start;
		}
	}

	@container site-footer (min-width: 56rem) {
		.site-footer__grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr) auto;
			align-items: start;
		}

		.site-footer__icons {
			grid-column: auto;
			justify-content: flex-end;
			padding-block-start: 1.85rem;
		}

		.site-footer__copy {
			text-align: start;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.site-footer__icon-link:hover {
			color: var(--primary, #ffe082);
			border-color: color-mix(in srgb, var(--accent, #ffe082) 50%, var(--border));
			background: color-mix(in srgb, var(--accent, #ffe082) 12%, var(--bg));
		}
	}

	@media (pointer: coarse) {
		.site-footer {
			--footer-icon-size: 1.5rem;
			--footer-icon-target: 3rem;
		}

		.site-footer__icon-link:active {
			transform: scale(0.94);
			background: color-mix(in srgb, var(--accent, #ffe082) 14%, var(--bg));
		}

		.site-footer__icons {
			gap: 0.85rem;
		}
	}
</style>
