---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found – Ark">
	<section class="not-found">
		<h1>Page not found</h1>
		<p>
			<a href="/">Back home</a>
		</p>
	</section>
</Layout>

<style>
	.not-found {
		flex: 1;
		display: grid;
		place-content: center;
		gap: 1rem;
		padding: 2rem 1.5rem;
		text-align: center;
	}

	.not-found h1 {
		margin: 0;
	}

	.not-found p {
		margin: 0;
	}
</style>
