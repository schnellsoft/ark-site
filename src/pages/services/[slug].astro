---
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/services/services.json';
import { mediaUrl } from '../../lib/media';
import {
	ServicePageView,
	type ServicePageData,
} from '../../components/services/ServicePageView';

type LocaleMap = { ro?: string; en?: string; bg?: string };
type ServicePage = {
	slug: string;
	title: LocaleMap;
	synopsis: LocaleMap;
	paragraphs: { ro?: string[]; en?: string[]; bg?: string[] };
	images: Array<{ master: string; webp?: string | null; alt: LocaleMap }>;
	price: string;
	currency: string;
	iconSvg?: string;
	pagePath?: string;
};

export function getStaticPaths() {
	const services = Array.isArray((catalog as { services?: unknown[] }).services)
		? (catalog as { services: Array<{ slug: string }> }).services
		: [];
	return services
		.filter((s) => s?.slug)
		.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect('/');
}

const pageModules = import.meta.glob('../../data/services/pages/*.json', {
	eager: true,
	import: 'default',
}) as Record<string, ServicePage>;

let page: ServicePage | null = null;
for (const [path, doc] of Object.entries(pageModules)) {
	const fromPath = path.split('/').pop()?.replace(/\.json$/, '') ?? '';
	if ((doc?.slug || fromPath) === slug) {
		page = doc;
		break;
	}
}

if (!page) {
	return Astro.redirect('/');
}

const images: ServicePageData['images'] = (page.images || []).map((img) => ({
	src: mediaUrl(img.webp || img.master),
	alt: img.alt,
}));

const viewPage: ServicePageData = {
	slug: page.slug,
	title: page.title,
	synopsis: page.synopsis,
	paragraphs: page.paragraphs,
	images,
	price: page.price,
	currency: page.currency,
	iconSvg: page.iconSvg,
};

const titleRo = page.title?.ro || page.title?.en || slug;
---

<Layout title={`${titleRo} | Ark Medical Clinic`}>
	<ServicePageView client:load page={viewPage} />
</Layout>

<style is:global>
	.svc-page {
		width: min(100%, 48rem);
		margin: 0 auto;
		padding: calc(var(--header-block-size) + 1.5rem) var(--content-inline) 3rem;
		color: #e8ecef;
	}

	.svc-page-header {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.svc-page-icon {
		width: 3.5rem;
		height: 3.5rem;
		color: var(--primary, #ffe082);
	}

	.svc-page-icon svg {
		width: 100%;
		height: 100%;
	}

	.svc-page-kicker {
		margin: 0;
		font-size: 0.9rem;
	}

	.svc-page-kicker a {
		color: var(--primary, #ffe082);
		text-decoration: none;
	}

	.svc-page-kicker a:hover {
		text-decoration: underline;
	}

	.svc-page h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.35rem);
		line-height: 1.2;
		color: var(--primary, #ffe082);
	}

	.svc-page-synopsis {
		margin: 0;
		color: #9aa3a8;
		font-size: 1.05rem;
		line-height: 1.55;
	}

	.svc-page-price {
		margin: 0;
		font-size: 1.25rem;
		font-variant-numeric: tabular-nums;
		color: var(--primary, #ffe082);
	}

	.svc-page-price span {
		font-size: 0.85em;
		opacity: 0.85;
	}

	.svc-page-select {
		appearance: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		min-height: 2.75rem;
		padding: 0.65rem 1.35rem;
		margin-block-start: 0.35rem;
		border: none;
		border-radius: 0.7rem;
		color: #121212;
		background: var(--primary, #ffe082);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 35%, transparent) inset,
			0 8px 22px color-mix(in srgb, #ffe082 28%, transparent);
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			transform 0.1s ease,
			box-shadow 0.15s ease;
	}

	.svc-page-select.is-selected {
		background: transparent;
		color: var(--primary, #ffe082);
		box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--primary, #ffe082) 70%, transparent);
	}

	@media (hover: hover) and (pointer: fine) {
		.svc-page-select:hover {
			background: #ffeca8;
		}

		.svc-page-select.is-selected:hover {
			background: color-mix(in srgb, var(--primary, #ffe082) 12%, transparent);
		}
	}

	.svc-page-select:focus-visible {
		outline: 2px solid var(--primary, #ffe082);
		outline-offset: 3px;
	}

	.svc-page-select:active {
		transform: scale(0.97);
	}

	@media (pointer: coarse) {
		.svc-page-select {
			min-height: 3rem;
		}
	}

	.svc-page-body {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.svc-page-body p {
		margin: 0;
	}

	.svc-page-gallery {
		display: grid;
		gap: 1rem;
		margin: 2rem 0 0;
		padding: 0;
	}

	.svc-page-gallery img {
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		border: 1px solid #2a3236;
	}
</style>
