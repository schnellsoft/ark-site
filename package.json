{
  "name": "ark-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sync:header": "node scripts/sync-header-content.mjs",
    "sync:slideshow": "node scripts/sync-slideshow-content.mjs",
    "sync:services": "node scripts/sync-services-content.mjs",
    "sync:all": "npm run sync:header && npm run sync:slideshow && npm run sync:services",
    "prebuild": "node scripts/sync-slideshow-content.mjs && node scripts/sync-services-content.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@fontsource/roboto": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uikit": "^3.25.26"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd@1.20261006.1": true
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "wrangler": "^4.148.0"
  }
}
